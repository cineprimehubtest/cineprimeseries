# CinePrimeSeries - Environment Configuration Template
# Duplicate this file to .env.local for local development.
# Configure these variables in Vercel project settings for production.
# Keep .env and .env.local private. NEVER commit real credentials to version control.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# TMDB API Key (v3 auth from themoviedb.org)
TMDB_API_KEY=

# TVmaze API Key (optional - TVmaze public endpoints function without a key)
TVMAZE_API_KEY=

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB Database Name
MONGODB_DATABASE=CinePrimeSeries

# Telegram Bot Username (without @ symbol or with @)
TELEGRAM_BOT_USERNAME=CinePrimeSeries_bot

# Official Telegram Channel / Community URL
TELEGRAM_CHANNEL_URL=https://t.me/CinePrimeSeries

# Secret passphrase/token for Admin Dashboard authentication
ADMIN_AUTH_SECRET=
